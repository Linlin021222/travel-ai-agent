# Server
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL + pgvector
DATABASE_URL=postgresql://flight_agent:change-this-local-password@localhost:5432/flight_agent?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Replace with a securely generated value before any shared deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# Swagger
SWAGGER_ENABLED=true

# LLM provider selection. Add only the credential for the provider you use.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
# For a local DeepSeek-R1 or Qwen3 model exposed through an OpenAI-compatible server.
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
